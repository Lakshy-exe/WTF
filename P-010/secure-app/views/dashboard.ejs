<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dashboard | FinSecure</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="navbar">
    <strong>🔒 FinSecure Portal (Secure App)</strong>
    <div>
      <a href="/comments">Comments</a>
      <a href="/logout">Logout</a>
    </div>
  </div>

  <div class="container">
    <h2>Welcome, <%= user.username %> 👋</h2>
    <p>You are logged in through a session-protected route. This page is only reachable
