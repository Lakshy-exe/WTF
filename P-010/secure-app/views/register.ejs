<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Register | FinSecure</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="navbar">
    <strong>🔒 FinSecure Portal (Secure App)</strong>
    <div><a href="/login">Login</a></div>
  </div>

  <div class="container">
    <h2>Create Account</h2>

    <% if (errors && errors.length > 0) { %>
      <div class="error-box">
        <ul class="error-list">
          <% errors.forEach(function(e) { %>
            <li><%= e %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <div class="policy-box">
      <b>Password policy:</b> minimum 8 characters, with at least one uppercase letter,
      one lowercase letter, one number, and one special character.
    </div>

    <form method="POST" action="/register">
      <label>Username</label>
      <input type="text" name="username" value="<%= username %>" required maxlength="20"
             placeholder="3-20 chars: letters, numbers, underscore">
      <label>Password</label>
      <input type="password" name="password" required maxlength="100">
      <label>Confirm Password</label>
      <input type="password" name="confirmPassword" required maxlength="100">
      <button type="submit">Register</button>
    </form>
    <p class="hint">Your password is hashed with bcrypt (salted, 12 rounds) before being stored —
      the server never saves or logs the plain-text password.</p>
  </div>
</body>
</html>
