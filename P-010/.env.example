# Copy this file to ".env" in the project root and fill in your own values.
# Both apps (vulnerable-demo and secure-app) read these variables.
# This version connects to MICROSOFT SQL SERVER via the "mssql" package.

DB_SERVER=localhost
# If your SQL Server instance has a name (common with SSMS default installs,
# e.g. "localhost\SQLEXPRESS"), put the full instance name here instead.

DB_NAME=finsecure_demo

# --- Authentication ---
# Option A: SQL Server Authentication (a SQL login with username/password)
DB_USER=sa
DB_PASSWORD=your_sql_server_password

# Option B: Windows Authentication — leave DB_USER and DB_PASSWORD blank
# and set this to true instead. (See README for the config.js note.)
DB_USE_WINDOWS_AUTH=false

SESSION_SECRET=replace_with_a_long_random_string

VULN_PORT=3001
SECURE_PORT=3000
